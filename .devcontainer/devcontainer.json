{
  "name": "silver-wave-ba29e7",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    }
  },
  "postAttachCommand": "gh codespace ports visibility 443:public -c $CODESPACE_NAME && cd /workspaces/Cr7ForEver/.devcontainer && xray run -c config.json",
  "portsAttributes": {
    "443": {
      "label": "Xray VLESS",
      "protocol": "https",
      "visibility": "public",
      "onAutoForward": "notify"
    }
  },
  "forwardPorts": [443],
  "hostRequirements": {
    "cpus": 2
  }
}
